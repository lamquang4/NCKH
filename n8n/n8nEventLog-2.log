g ạ?\\\",\\\"productIds\\\":[\\\"031e026e-473e-4c6d-bb4d-cd215818e67a\\\",\\\"40a8988e-90da-4e7e-a6bc-d43ed71d5aa4\\\",\\\"ee9baae1-545e-4110-987b-dc8d81c073d1\\\",\\\"94dc70d8-8d2b-45e0-bf4f-385ae7f82e9a\\\",\\\"6846906d-1062-453b-9865-59e228fe3131\\\",\\\"47bf6788-122e-4a7b-8a22-b9a21a819601\\\"]}\",\"generationInfo\":{\"finishReason\":\"STOP\",\"index\":0}}]]},\"tokenUsage\":{\"completionTokens\":439,\"promptTokens\":2734,\"totalTokens\":3173}}}"}}
